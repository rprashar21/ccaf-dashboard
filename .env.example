# Copy to .env and fill in. Never commit .env.

# Postgres — matches docker-compose.yml defaults for local dev.
DATABASE_URL="postgresql://ccaf:ccaf@localhost:5432/ccaf?schema=public"

# Auth.js. Generate a secret with: pnpm dlx auth secret
AUTH_SECRET=""

# GitHub OAuth app: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth client: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
